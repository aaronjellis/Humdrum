# Swift Package Manager build artifacts
.build/
.swiftpm/
# Package.resolved is INTENTIONALLY committed for this app target.
# It pins exact dependency versions so CI builds match local builds —
# without it, fresh CI runs resolve to whatever's latest within the
# `from:` version range, which silently drifts and breaks builds when
# a transitive dep ships a breaking minor (we hit this with
# FluidAudio 0.13 → 0.14 making `performCompleteDiarization` async).
# Re-add `Package.resolved` here only if Humdrum becomes a library.

# Built app bundle + distribution zip — regenerated by ./build-app.sh
*.app/
*.zip

# Per-commit rebuild counter used by build-app.sh to auto-bump
# CFBundleVersion. Intentionally machine-local; no reason to share.
.build-number

# git-lfs-fetched Whisper model staging area — regenerated by build script
BundledWhisperModels/

# Notarization / codesign artifacts that may be written during release
*.cer
*.p12
NotarizationLog.json

# macOS junk
.DS_Store
*.swp
.AppleDouble
.LSOverride

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# User-specific editor files
.vscode/
.idea/
