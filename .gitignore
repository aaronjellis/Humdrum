# Swift Package Manager build artifacts
.build/
.swiftpm/
# Package.resolved is INTENTIONALLY committed for this app target.
# It pins exact dependency versions so CI builds match local builds —
# without it, fresh CI runs resolve to whatever's latest within the
# `from:` version range, which silently drifts and breaks builds when
# a transitive dep ships a breaking minor (we hit this with
# FluidAudio 0.13 → 0.14 making `performCompleteDiarization` async).
# Re-add `Package.resolved` here only if Humdrum becomes a library.

# Built app bundle + distribution zip — regenerated by ./build-app.sh
*.app/
*.zip

# (.build-number used to live here — removed when we collapsed to a
# single-version policy. CFBundleVersion is now copied from
# CFBundleShortVersionString at build time, no auto-bump.)

# git-lfs-fetched Whisper model staging area — regenerated by build script
BundledWhisperModels/

# Notarization / codesign artifacts that may be written during release
*.cer
*.p12
NotarizationLog.json

# macOS junk
.DS_Store
*.swp
.AppleDouble
.LSOverride

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# User-specific editor files
.vscode/
.idea/

# Personal planning / brainstorming artifacts at repo root.
# Convention: real project docs live in Docs/ and are committed.
# Anything at the repo root that looks like a planning artifact
# (caps-and-underscores name, `feasibility_*`, `_bmad/` working
# directory) is local-only and should never be committed.
/DEVELOPMENT_PLAN.md
/REVISED_DEVELOPMENT_PLAN.md
/STARTER_PLAN.md
/FEATURE_IDEATION.md
/FINAL_REVIEW.md
/FRUSTRATION_MINING.md
/PHONE_MIC_DEEP_DIVE.md
/TECHNICAL_FEASIBILITY.md
/feasibility_*.md
# `_bmad` is a symlink to a shared planning workspace; no trailing
# slash here so the pattern matches the symlink itself.
/_bmad
/ADVERSARIAL_*.md
