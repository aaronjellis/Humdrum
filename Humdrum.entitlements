<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Explicitly allow microphone access. Required for hardened runtime,
         and harmless otherwise. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- No App Sandbox: WhisperKit needs to download models to a writable
         location (~/Library/Application Support) and to run Core ML from
         cached .mlmodelc bundles. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Core ML on some Macs requires JIT / unsigned executable memory to
         load .mlmodelc bundles under hardened runtime. Declaring these up
         front keeps notarization happy. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- SwiftPM-bundled frameworks (WhisperKit, FluidAudio) can be signed
         by different Team IDs than this app. Hardened runtime would
         otherwise refuse to load them. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow outbound network for the one-time Whisper / diarization
         model download from Hugging Face. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
