<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Explicitly allow microphone access. Required for hardened runtime,
         and harmless otherwise. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- No App Sandbox: WhisperKit needs to download models to a writable
         location and to run Core ML. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow JIT / unsigned memory for Core ML model loading on some Macs. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow outbound network for the one-time model download from
         Hugging Face. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
